# Copy to .env.local and replace every placeholder before using authentication.
DATABASE_URL=postgresql://hma_app:replace-me@localhost:5432/hotspot_manager_africa
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_SSL=false

# Liste séparée par des virgules des identifiants utilisateur autorisés à ouvrir /admin.
# Laisser vide désactive l’accès à la console globale.
SUPER_ADMIN_USER_IDS=

# Chiffrement des identifiants de tickets (AES-256-GCM). Générer une clé avec:
# node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64'))"
# Format du trousseau: version:clé-base64,version-suivante:clé-base64
TICKET_ENCRYPTION_KEYS=v1:replace-with-32-byte-base64-key
TICKET_ENCRYPTION_ACTIVE_KEY_VERSION=v1

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
EMAIL_FROM=HOTSPOT MANAGER AFRICA <no-reply@example.com>
